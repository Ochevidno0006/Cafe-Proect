# Адрес бэкенда
VITE_API_BASE=http://localhost:4000

# ЛОКАЛЬНАЯ РАЗРАБОТКА: можно задать конкретный slug кафе для удобства.
# В ПРОДАКШЕНЕ (Netlify) НЕ задавай эту переменную — тогда slug кафе
# берётся из адресной строки (/chaihona-vostok-...), и одно приложение
# обслуживает сразу все кафе платформы.
VITE_CAFE_SLUG=
