{
  "name": "cafe-menu-saas-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Backend API for the cafe online-menu SaaS platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node src/db/migrate.js up && node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js up",
    "migrate:down": "node src/db/migrate.js down",
    "migrate:status": "node src/db/migrate.js status",
    "seed:superadmin": "node src/db/seedSuperAdmin.js",
    "seed:demo": "node src/db/seedDemoData.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}
