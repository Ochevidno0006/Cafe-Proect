# Сервер
NODE_ENV=development
PORT=4000
# Список разрешённых origin через запятую (для CORS)
CLIENT_ORIGIN=http://localhost:5173

# База данных PostgreSQL
DATABASE_URL=postgres://cafeapp:cafeapp_dev_pw@localhost:5432/cafe_menu_dev
# Включить SSL для управляемых БД (Neon/Render/RDS и т.п.)
DATABASE_SSL=false

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Регистрация первого Super Admin (используется скриптом seed:superadmin)
SUPERADMIN_PHONE=+992000000000
SUPERADMIN_PASSWORD=change_me_strong_password
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin

# Брутфорс-защита логина
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
